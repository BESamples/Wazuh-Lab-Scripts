 <group name="local,windows,powershell,custom_fim,pii,">

  <rule id="100100" level="8">
    <if_sid>60122</if_sid>
    <description>Custom: Failed Login</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>60118</if_sid>
    <description>Custom: Successful Login</description>
  </rule>

  <rule id="100102" level="8">
    <if_sid>91815</if_sid>
    <description>Custom: Powershell execution</description>
  </rule>

<rule id="100103" level="10">
    <if_sid>550,554</if_sid>
    <field name="file" type="pcre2">(?i).*ssn.*|.*social.*|.*pii.*</field>
    <description>Possible PII-related file detected or modified: $(file)</description>
  </rule>

  <rule id="100104" level="12">
    <if_sid>550,554</if_sid>
    <match type="pcre2">\b\d{3}-\d{2}-\d{4}\b</match>
    <description>Possible SSN pattern detected in monitored file change: $(file)</description>
  </rule>

  <rule id="100105" level="8">
   <if_sid>550,554</if_sid>
   <match type="pcre2">password|confidential|secret</match>
   <description>Sensitive keyword detected in file</description>
  </rule>

  <rule id="100106" level="9">
   <if_sid>554</if_sid>
   <field name="file" type="pcre2">(?i)\.ps1$|\.bat$|\.exe$</field>
   <description>Executable or script file added</description>
  </rule>


<rule id="100107" level="12">
  <if_sid>554</if_sid>
  <field name="file" type="pcre2">(?i)\.locked$|\.encrypted$|\.crypt$</field>
  <description>Possible ransomware-encrypted file detected</description>
</rule>

  
  <rule id="100300" level="10" frequency="5" timeframe="60">
   <if_matched_sid>100100</if_matched_sid>
   <description>Custom: Multiple failed logins detected (possible brute force)</description>
  </rule>

  <rule id="100301" level="12">
   <if_sid>91815</if_sid>
   <match>-enc</match>
   <description>Custom: PowerShell encoded command detected</description>
  </rule>

  <rule id="100302" level="9">
   <if_sid>60122</if_sid>
   <description>Custom: Account lockout detected</description>
  </rule>
  
<rule id="100303" level="14" frequency="20" timeframe="60">
  <if_matched>550</if_matched>
  <description>Mass file modifications detected possible ransomware activity</description>
</rule>

  
 </group>
