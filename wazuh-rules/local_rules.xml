<group name="local,syscheck,windows,powershell,custom_fim,pii,sysmon,lab_attack_simulation,">

  <!-- Windows login activity -->
  <rule id="100100" level="8">
    <if_sid>60122</if_sid>
    <description>Custom: Failed Windows login detected</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>60118</if_sid>
    <description>Custom: Successful Windows login detected</description>
  </rule>

  <!-- PowerShell activity from Wazuh built-in Windows/PowerShell rules -->
  <rule id="100102" level="8">
    <if_sid>91815</if_sid>
    <description>Custom: PowerShell execution detected</description>
  </rule>

 <!-- FIM / PII detections -->

<rule id="100103" level="10">
  <if_sid>554</if_sid>
  <field name="file" type="pcre2">(?i).*(ssn|social|pii|password|payroll|confidential|secret).*</field>
  <description>Added sensitive-looking file: $(file)</description>
</rule>

<rule id="100104" level="10">
  <if_sid>550</if_sid>
  <field name="file" type="pcre2">(?i).*(ssn|social|pii|password|payroll|confidential|secret).*</field>
  <description>Modified sensitive-looking file: $(file)</description>
</rule>
 
  <rule id="100107" level="9">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)\.ps1$|\.bat$|\.exe$</field>
    <description>Executable or script file added to monitored directory: $(file)</description>
  </rule>

  <rule id="100108" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)\.locked$|\.encrypted$|\.crypt$</field>
    <description>Possible ransomware-style encrypted file extension detected: $(file)</description>
  </rule>

  <!-- Sysmon PowerShell / lab attack simulation rules -->
  <rule id="100109" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-encodedcommand|\s-enc\s</field>
    <description>LAB: Encoded PowerShell command detected</description>
  </rule>

  <rule id="100520" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)fake-updater\.ps1</field>
    <description>LAB: Fake updater payload executed on Windows endpoint</description>
  </rule>

  <rule id="100521" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)executionpolicy\s+bypass</field>
    <description>LAB: PowerShell executed with ExecutionPolicy Bypass</description>
  </rule>

  <rule id="100522" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)invoke-restmethod|invoke-webrequest|curl|wget</field>
    <description>LAB: PowerShell web callback or download activity detected</description>
  </rule>

  <rule id="100523" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)c:\\users\\public\\.*\.ps1</field>
    <description>LAB: PowerShell script executed from Public user directory</description>
  </rule>

  <!-- Correlation / frequency rules -->
  <rule id="100300" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <description>Custom: Multiple failed Windows logins detected within 60 seconds</description>
  </rule>

  <rule id="100303" level="14" frequency="20" timeframe="60">
    <if_matched_sid>550</if_matched_sid>
    <description>Mass file modifications detected: possible ransomware activity</description>
  </rule>

</group>
