<group name="local,syscheck,windows,powershell,custom_fim,pii,sysmon,lab_attack_simulation,yara,">

  <!-- Windows login activity -->
  <rule id="100100" level="8">
    <if_sid>60122</if_sid>
    <description>Custom: Failed Windows login detected</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>60118</if_sid>
    <description>Custom: Successful Windows login detected</description>
  </rule>

  <!-- PowerShell activity -->
  <rule id="100102" level="8">
    <if_sid>91815</if_sid>
    <description>Custom: PowerShell execution detected</description>
  </rule>

  <!-- FIM / filename-based PII detections -->
  <rule id="100103" level="10">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i).*(ssn|social|pii|password|payroll|confidential|secret).*</field>
    <description>Added sensitive-looking file by filename: $(file)</description>
  </rule>

  <rule id="100104" level="10">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">(?i).*(ssn|social|pii|password|payroll|confidential|secret).*</field>
    <description>Modified sensitive-looking file by filename: $(file)</description>
  </rule>

  <!-- FIM / suspicious file types -->
  <rule id="100107" level="9">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i).*\.(ps1|bat|exe)$</field>
    <description>Executable or script file added to monitored directory: $(file)</description>
  </rule>

  <rule id="100108" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i).*\.(locked|encrypted|crypt)$</field>
    <description>Possible ransomware-style encrypted file extension detected: $(file)</description>
  </rule>

  <!-- Sysmon PowerShell / lab attack simulation rules -->
  <rule id="100109" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-encodedcommand|\s-enc\s)</field>
    <description>LAB: Encoded PowerShell command detected</description>
  </rule>

    <!-- TEMP TEST: Any Sysmon Event 1 -->
  <rule id="100529" level="6">
    <if_group>sysmon_event1</if_group>
    <description>LAB TEST: Any Sysmon Event 1 process creation detected</description>
    <group>lab_sysmon_dashboard,</group>
  </rule>

  <rule id="100520" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)fake-updater\.ps1</field>
    <description>LAB: Fake updater payload executed on Windows endpoint</description>
  </rule>

  <rule id="100521" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)executionpolicy\s+bypass</field>
    <description>LAB: PowerShell executed with ExecutionPolicy Bypass</description>
  </rule>

  <rule id="100522" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(invoke-restmethod|invoke-webrequest|curl|wget)</field>
    <description>LAB: PowerShell web callback or download activity detected</description>
  </rule>

    <rule id="100523" level="13">
    <if_sid>92029</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)c:\\users\\public\\.*\.ps1</field>
    <description>LAB: PowerShell script executed from Public user directory</description>
    <group>lab_sysmon_dashboard,sysmon_public_script,</group>
  </rule>

  <!-- Correlation / frequency rules -->
  <rule id="100300" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <description>Custom: Multiple failed Windows logins detected within 60 seconds</description>
  </rule>

  <rule id="100303" level="14" frequency="20" timeframe="60">
    <if_matched_sid>550</if_matched_sid>
    <description>Mass file modifications detected: possible ransomware activity</description>
  </rule>

  <!-- YARA generic detection -->
  <rule id="100302" level="10">
    <match>YARA_MATCH:</match>
    <description>LAB: YARA detection on endpoint</description>
  </rule>

  <!-- YARA PII-specific detections -->
  <rule id="100310" level="12">
    <match>PII_SSN_Detected</match>
    <description>LAB: Social Security Number detected by YARA</description>
  </rule>

  <rule id="100311" level="10">
    <match>PII_Password_Detected</match>
    <description>LAB: Password-related content detected by YARA</description>
  </rule>

  <rule id="100312" level="10">
    <match>PII_Payroll_Detected</match>
    <description>LAB: Payroll-related content detected by YARA</description>
  </rule>

  <!-- YARA malware/ransomware lab detections -->
  <rule id="100313" level="12">
    <match>Test_Malware_String</match>
    <description>LAB: Malware test string detected by YARA</description>
  </rule>

  <rule id="100314" level="13">
    <match>Ransomware_Note_Detected</match>
    <description>LAB: Ransomware note content detected by YARA</description>
  </rule>

  <!-- Windows PowerShell DLP Scanner Alerts -->

  <rule id="100700" level="7">
    <decoded_as>json</decoded_as>
    <field name="scanner">windows_powershell_dlp_scanner</field>
    <description>Windows DLP scanner alert detected</description>
    <group>dlp,windows_dlp,</group>
  </rule>

  <rule id="100701" level="12">
    <if_sid>100700</if_sid>
    <field name="severity">high</field>
    <description>HIGH severity Windows DLP alert detected</description>
    <group>dlp,windows_dlp,high,</group>
  </rule>

  <rule id="100702" level="8">
    <if_sid>100700</if_sid>
    <field name="severity">medium</field>
    <description>MEDIUM severity Windows DLP alert detected</description>
    <group>dlp,windows_dlp,medium,</group>
  </rule>

  <rule id="100703" level="10">
    <if_sid>100700</if_sid>
    <field name="match_type">ssn</field>
    <description>Windows DLP detected possible SSN data</description>
    <group>dlp,windows_dlp,ssn,</group>
  </rule>

  <rule id="100704" level="10">
    <if_sid>100700</if_sid>
    <field name="match_type">credit_card</field>
    <description>Windows DLP detected possible credit card data</description>
    <group>dlp,windows_dlp,credit_card,</group>
  </rule>

  <rule id="100705" level="12">
    <if_sid>100700</if_sid>
    <field name="match_type">aws_access_key</field>
    <description>Windows DLP detected possible AWS access key</description>
    <group>dlp,windows_dlp,aws,</group>
  </rule>

  <rule id="100706" level="12">
    <if_sid>100700</if_sid>
    <field name="match_type">database_password</field>
    <description>Windows DLP detected possible database password</description>
    <group>dlp,windows_dlp,password,</group>
  </rule>
  
</group>
